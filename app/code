<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
<footer class="creator-footer">
    Brewed &amp; Crafted by <span>ANTABIN DAS</span>
</footer>
<div style="margin-top: 12px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
  <a href="#play-area" style="background: linear-gradient(135deg, #f5b942, #e08e26); color: #191005; text-decoration: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.9rem;">
    Play Game
  </a>
  <a href="assets/poster.png" target="_blank" rel="noopener noreferrer" style="background: rgba(154, 215, 232, 0.16); color: #9ad7e8; border: 1px solid #9ad7e8; text-decoration: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">
    Open Poster
  </a>
</div>


    <title>The Midnight Tea Shop</title>
    <!-- Google Fonts: Cormorant Garamond for poetic narrative & Plus Jakarta Sans for clean UI -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-night-deep: #0b0d1e;
            --bg-twilight: #1a183b;
            --bg-horizon: #2d2352;
            --wood-dark: #23140e;
            --wood-mid: #3a2218;
            --wood-warm: #543324;
            --amber-glow: #ffb74d;
            --gold-bright: #ffe082;
            --gold-soft: rgba(255, 213, 128, 0.25);
            --spirit-cyan: #80deea;
            --spirit-lavender: #ce93d8;
            --text-cream: #fdf6e3;
            --text-muted: #cbbba0;
            --glass-panel: rgba(24, 17, 22, 0.78);
            --border-gold: rgba(255, 193, 7, 0.32);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(180deg, var(--bg-night-deep) 0%, var(--bg-twilight) 55%, var(--bg-horizon) 100%);
            color: var(--text-cream);
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        h1, h2, h3, .serif-text {
            font-family: 'Cormorant Garamond', serif;
        }

        /* Background Canvas for Stars, Clouds & Golden Particles */
        #atmosphere-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        /* Top Navigation / Header Bar */
        header {
            position: relative;
            z-index: 10;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 24px;
            background: linear-gradient(180deg, rgba(11, 13, 30, 0.85) 0%, rgba(11, 13, 30, 0) 100%);
        }

        .brand-badge {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-badge span {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--gold-bright);
            text-shadow: 0 0 15px rgba(255, 183, 77, 0.45);
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .keepsake-shelf {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(35, 20, 14, 0.75);
            border: 1px solid var(--border-gold);
            padding: 6px 14px;
            border-radius: 999px;
            backdrop-filter: blur(8px);
        }

        .keepsake-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-right: 4px;
        }

        .keepsake-slot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed rgba(255, 213, 128, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        .keepsake-slot.unlocked {
            background: radial-gradient(circle, rgba(255, 224, 130, 0.35), rgba(255, 183, 77, 0.1));
            border: 1px solid var(--amber-glow);
            box-shadow: 0 0 12px rgba(255, 183, 77, 0.6);
            transform: scale(1.1);
        }

        .icon-btn {
            background: rgba(35, 20, 14, 0.8);
            border: 1px solid var(--border-gold);
            color: var(--gold-bright);
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s ease;
            backdrop-filter: blur(6px);
        }

        .icon-btn:hover {
            background: var(--wood-warm);
            border-color: var(--amber-glow);
            box-shadow: 0 0 14px rgba(255, 183, 77, 0.35);
        }

        /* Decorative Hanging Lanterns */
        .lantern-row {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            pointer-events: none;
            z-index: 2;
            display: flex;
            justify-content: space-between;
            padding: 0 6%;
        }

        .lantern {
            transform-origin: top center;
            animation: sway 5s ease-in-out infinite alternate;
            filter: drop-shadow(0 8px 18px rgba(255, 167, 38, 0.55));
        }

        .lantern:nth-child(2) {
            animation-duration: 6.2s;
            animation-delay: -1.5s;
        }

        @keyframes sway {
            0% { transform: rotate(-3.5deg); }
            100% { transform: rotate(3.5deg); }
        }

        /* Main Screen Container */
        main {
            position: relative;
            z-index: 5;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px 20px 28px;
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
        }

        /* Title Screen Overlay */
        #title-screen {
            text-align: center;
            max-width: 680px;
            padding: 44px 32px;
            background: radial-gradient(circle at center, rgba(44, 27, 20, 0.88) 0%, rgba(20, 14, 24, 0.92) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 28px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), inset 0 0 40px rgba(255, 183, 77, 0.08);
            backdrop-filter: blur(12px);
            animation: fadeInScale 0.8s ease-out;
        }

        .title-crest {
            margin: 0 auto 18px;
            width: 84px;
            height: 84px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 213, 128, 0.25), transparent 70%);
            border: 1px solid var(--border-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 30px rgba(255, 183, 77, 0.25);
        }

        #title-screen h1 {
            font-size: clamp(2.5rem, 5vw, 3.8rem);
            font-weight: 700;
            color: var(--gold-bright);
            line-height: 1.1;
            margin-bottom: 12px;
            text-shadow: 0 4px 20px rgba(255, 183, 77, 0.4);
        }

        .tagline {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: clamp(1.2rem, 2.5vw, 1.5rem);
            color: var(--text-muted);
            margin-bottom: 26px;
        }

        .intro-desc {
            font-size: 0.96rem;
            line-height: 1.65;
            color: #e6dcc8;
            margin-bottom: 32px;
            padding: 0 12px;
        }

        .primary-btn {
            background: linear-gradient(135deg, #ffb74d 0%, #f57c00 100%);
            color: #1c0f08;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            padding: 15px 38px;
            border: none;
            border-radius: 999px;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(245, 124, 0, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.6);
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            letter-spacing: 0.3px;
        }

        .primary-btn:hover:not(:disabled) {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 12px 32px rgba(255, 183, 77, 0.65);
        }

        .primary-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Gameplay Layout Grid */
        #game-screen {
            display: none;
            width: 100%;
            grid-template-columns: 1.05fr 1fr;
            gap: 24px;
            align-items: stretch;
            animation: fadeInScale 0.6s ease-out;
        }

        @media (max-width: 920px) {
            #game-screen {
                grid-template-columns: 1fr;
            }
        }

        /* Left Column: Tea Stall Counter & Spirit Visitor */
        .stall-stage {
            background: linear-gradient(180deg, rgba(31, 22, 46, 0.72) 0%, rgba(35, 20, 14, 0.92) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 26px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(10px);
            min-height: 510px;
        }

        /* Warm Stall Roof Eaves Accent */
        .stall-eaves {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 14px;
            background: repeating-linear-gradient(
                90deg,
                #4a2818 0px,
                #4a2818 36px,
                #2c160c 36px,
                #2c160c 40px
            );
            border-bottom: 2px solid var(--amber-glow);
            box-shadow: 0 4px 20px rgba(255, 183, 77, 0.3);
        }

        .visitor-progress {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 6px;
            font-size: 0.8rem;
            color: var(--text-muted);
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .spirit-stage-center {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 12px 0;
        }

        .spirit-aura {
            position: absolute;
            width: 210px;
            height: 210px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(128, 222, 234, 0.22) 0%, rgba(206, 147, 216, 0.08) 50%, transparent 72%);
            filter: blur(8px);
            transition: all 1s ease;
            pointer-events: none;
        }

        .spirit-aura.restored {
            background: radial-gradient(circle, rgba(255, 224, 130, 0.48) 0%, rgba(255, 167, 38, 0.2) 55%, transparent 75%);
            transform: scale(1.28);
        }

        #spirit-svg-container {
            width: 185px;
            height: 185px;
            position: relative;
            z-index: 2;
            animation: floatSpirit 4.2s ease-in-out infinite;
            transition: all 0.9s ease;
        }

        #spirit-svg-container.ascending {
            transform: translateY(-45px) scale(1.06);
            opacity: 0;
            filter: brightness(1.6) blur(2px);
        }

        @keyframes floatSpirit {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        /* Wooden Countertop Divider */
        .wooden-counter {
            background: linear-gradient(180deg, #5c3726 0%, #381f14 100%);
            border-top: 2px solid #8d5b42;
            border-radius: 18px;
            padding: 18px 20px;
            position: relative;
            z-index: 3;
            box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.4);
        }

        .spirit-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 6px;
        }

        .spirit-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--gold-bright);
        }

        .spirit-epithet {
            font-size: 0.8rem;
            color: var(--spirit-cyan);
            font-weight: 500;
            letter-spacing: 0.4px;
        }

        .dialogue-box {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.24rem;
            line-height: 1.52;
            color: #fff8eb;
            min-height: 92px;
        }

        .dialogue-hint-highlight {
            color: var(--amber-glow);
            font-style: italic;
            font-weight: 600;
            text-shadow: 0 0 10px rgba(255, 183, 77, 0.3);
        }

        .spirit-action-row {
            margin-top: 14px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Right Column: Tea Brewing Station */
        .brewing-station {
            background: var(--glass-panel);
            border: 1px solid var(--border-gold);
            border-radius: 26px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(12px);
        }

        .station-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .station-title-row h2 {
            font-size: 1.65rem;
            color: var(--gold-bright);
        }

        .selection-counter {
            font-size: 0.82rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.06);
            padding: 4px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Ingredient Shelf Grid */
        .ingredients-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 11px;
            margin-bottom: 18px;
        }

        @media (max-width: 500px) {
            .ingredients-grid {
                grid-template-columns: 1fr;
            }
        }

        .ingredient-card {
            background: linear-gradient(145deg, rgba(58, 34, 24, 0.72), rgba(32, 19, 14, 0.88));
            border: 1px solid rgba(255, 213, 128, 0.18);
            border-radius: 16px;
            padding: 12px 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
            text-align: left;
            position: relative;
        }

        .ingredient-card:hover:not(:disabled) {
            transform: translateY(-2px);
            border-color: rgba(255, 183, 77, 0.55);
            background: linear-gradient(145deg, rgba(78, 46, 32, 0.85), rgba(42, 25, 18, 0.92));
        }

        .ingredient-card.selected {
            border-color: var(--amber-glow);
            background: linear-gradient(145deg, rgba(112, 66, 32, 0.88), rgba(56, 31, 18, 0.95));
            box-shadow: 0 0 18px rgba(255, 183, 77, 0.32), inset 0 0 12px rgba(255, 224, 130, 0.15);
        }

        .ingredient-card:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .ing-icon-wrap {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            background: rgba(0, 0, 0, 0.28);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .ing-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .ing-name {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text-cream);
            line-height: 1.25;
        }

        .ing-tags {
            font-size: 0.74rem;
            color: var(--amber-glow);
            font-weight: 500;
            opacity: 0.9;
        }

        /* Teapot & Hearth Brewing Area */
        .teapot-hearth {
            background: radial-gradient(circle at bottom, rgba(255, 143, 0, 0.16) 0%, rgba(20, 13, 12, 0.85) 75%);
            border: 1px solid rgba(255, 183, 77, 0.25);
            border-radius: 20px;
            padding: 16px 18px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .selected-slots-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            width: 100%;
            margin-bottom: 14px;
        }

        .brew-slot {
            flex: 1;
            max-width: 195px;
            height: 46px;
            border-radius: 12px;
            border: 1px dashed rgba(255, 213, 128, 0.35);
            background: rgba(0, 0, 0, 0.28);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            font-size: 0.8rem;
            color: var(--text-muted);
            text-align: center;
            transition: all 0.3s ease;
        }

        .brew-slot.filled {
            border-style: solid;
            border-color: var(--amber-glow);
            background: rgba(255, 183, 77, 0.14);
            color: var(--gold-bright);
            font-weight: 600;
        }

        .teapot-visual-wrap {
            position: relative;
            width: 110px;
            height: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        /* Rising Steam Wisps */
        .steam-wisp {
            position: absolute;
            top: -12px;
            width: 8px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255, 248, 231, 0.38);
            filter: blur(4px);
            animation: riseSteam 3s ease-in-out infinite;
            pointer-events: none;
        }

        .steam-wisp:nth-child(1) { left: 42px; animation-delay: 0s; }
        .steam-wisp:nth-child(2) { left: 54px; animation-delay: 1s; height: 30px; }
        .steam-wisp:nth-child(3) { left: 64px; animation-delay: 2s; }

        @keyframes riseSteam {
            0% { transform: translateY(6px) scaleX(0.8); opacity: 0; }
            45% { opacity: 0.65; }
            100% { transform: translateY(-28px) scaleX(1.6); opacity: 0; }
        }

        .teapot-brewing {
            animation: kettleBubble 0.45s ease-in-out infinite alternate;
            filter: drop-shadow(0 0 16px rgba(255, 183, 77, 0.75));
        }

        @keyframes kettleBubble {
            0% { transform: rotate(-2deg) scale(1.02); }
            100% { transform: rotate(2deg) scale(1.06); }
        }

        .brew-controls {
            display: flex;
            gap: 10px;
            width: 100%;
            justify-content: center;
        }

        .secondary-btn {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-cream);
            border: 1px solid rgba(255, 213, 128, 0.3);
            padding: 12px 18px;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .secondary-btn:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.16);
            border-color: var(--gold-bright);
        }

        .secondary-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* End of Shift Ledger Screen */
        #ledger-screen {
            display: none;
            max-width: 780px;
            width: 100%;
            background: radial-gradient(circle at top, rgba(48, 30, 22, 0.94) 0%, rgba(20, 14, 24, 0.96) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 28px;
            padding: 36px 32px;
            box-shadow: 0 25px 65px rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(14px);
            text-align: center;
            animation: fadeInScale 0.7s ease-out;
        }

        #ledger-screen h2 {
            font-size: 2.5rem;
            color: var(--gold-bright);
            margin-bottom: 6px;
        }

        .ledger-subtitle {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 1.25rem;
            color: var(--text-muted);
            margin-bottom: 24px;
        }

        .ledger-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-bottom: 28px;
            text-align: left;
        }

        @media (max-width: 640px) {
            .ledger-list {
                grid-template-columns: 1fr;
            }
        }

        .ledger-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 193, 7, 0.25);
            border-radius: 16px;
            padding: 16px;
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .ledger-keepsake-icon {
            font-size: 1.8rem;
            background: rgba(255, 183, 77, 0.15);
            border: 1px solid var(--amber-glow);
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .ledger-card h4 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            color: var(--gold-bright);
            margin-bottom: 2px;
        }

        .ledger-keepsake-title {
            font-size: 0.78rem;
            color: var(--amber-glow);
            font-weight: 600;
            margin-bottom: 4px;
        }

        .ledger-memory-text {
            font-size: 0.84rem;
            color: #e0d6c3;
            line-height: 1.45;
        }

        /* Toast Notification */
        #toast-banner {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(90px);
            background: rgba(35, 20, 14, 0.95);
            border: 1px solid var(--amber-glow);
            color: var(--gold-bright);
            padding: 10px 22px;
            border-radius: 999px;
            font-size: 0.9rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            z-index: 50;
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
            pointer-events: none;
        }

        #toast-banner.show {
            transform: translateX(-50%) translateY(0);
        }

        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.96) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
</head>
<body>

